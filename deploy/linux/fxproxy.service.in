[Unit]
Description=fxproxy - HTTP/SOCKS5 landing proxy (Firefox IP Protection, multi-account)
Documentation=https://github.com/qq928820655/fxproxy-multi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%DIR%
Environment=FXPROXY_CONFIG=%CONFIG%
ExecStart=%BIN% -c %CONFIG% run
Restart=on-failure
RestartSec=5
# 单进程要扛几百条并发隧道（每条一个上游 TLS），默认 1024 不够
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
