{
  "manifest_version": 3,
  "name": "fxproxy — FxA Token Extractor",
  "version": "1.2.5",
  "description": "Extract the Firefox Accounts sessionToken from the signed-in browser as a Cookie header the fxproxy panel accepts directly",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://accounts.firefox.com/*",
    "https://accounts.firefox.com.cn/*",
    "https://api.accounts.firefox.com/*",
    "https://oauth.accounts.firefox.com/*",
    "https://api.accounts.firefox.com.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "fxproxy token extractor"
  },
  "content_scripts": [
    {
      "matches": [
        "https://accounts.firefox.com/*",
        "https://accounts.firefox.com.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
